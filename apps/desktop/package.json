{
  "name": "@business-suite/desktop",
  "version": "1.0.0",
  "description": "BusinessSuite Desktop Edition - Multi-tenant Commercial ERP & POS",
  "author": "BusinessSuite Inc.",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "compile": "tsc && node scripts/copy-assets.js",
    "build": "tsc && node scripts/copy-assets.js",
    "prepare:resources": "node scripts/prepare-postgres.js && node scripts/prepare-api.js && node scripts/prepare-web.js",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@business-suite/shared": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "electron": "30.5.1",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
